  "author": "kvker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvker/dsh-window-state.git"
  },
  "homepage": "https://github.com/kvker/dsh-window-state#readme",
  "bugs": {
    "url": "https://github.com/kvker/dsh-window-state/issues"
  },
  "engines": {
